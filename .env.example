# ===========================================================================
# Alfred — AI Comedy Benchmark: API key configuration
# ===========================================================================
# Copy this file to `.env` and fill in the keys for the providers you want to
# test.  `.env` is git-ignored — your real keys will NEVER be committed.
#
#     cp .env.example .env
#
# You do NOT need every key. Any provider whose key is missing is automatically
# skipped (or replaced by the built-in MOCK comedian if you pass --mock).
# ===========================================================================

# --- Anthropic (Claude) -----------------------------------------------------
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- OpenAI (GPT) -----------------------------------------------------------
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Google (Gemini) --------------------------------------------------------
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# --- xAI (Grok) -------------------------------------------------------------
# Get one at: https://console.x.ai/
XAI_API_KEY=

# --- Mistral ----------------------------------------------------------------
# Get one at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# --- Meta Llama / open models (via an OpenAI-compatible host) ----------------
# e.g. Groq (https://console.groq.com/keys) or Together
# (https://api.together.xyz/settings/api-keys). Set BOTH the key and the host.
GROQ_API_KEY=
TOGETHER_API_KEY=

# --- DeepSeek ---------------------------------------------------------------
# Get one at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
